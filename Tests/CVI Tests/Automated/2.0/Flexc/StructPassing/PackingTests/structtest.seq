Adapter = "None Adapter"
PreCond Line0001 = "(FileGlobals.WorkingSetStart != 0) && (FileGlobals.WorkingSetStart < FileGlobals.WorkingSetEnd) && (FileGlobals.WorkingS"
PreCond Line0002 = "etEnd - FileGlobals.WorkingSetStart > 1000)"
Mode = "Skip"

[DEF, SF.Seq[0].Main[19].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[SF.Seq[0].Main[19].Result]
%FLG: Response = 8192

[SF.Seq[0].Main[19]]
TitleExpr = "NameOf(RunState.Sequence)"
%FLG: TitleExpr = 0
MessageExpr Line0001 = "\"Possible Memory Leak in \" + NameOf(RunState.Sequence) + \"\\n\" + \n\"    FileGlobals.WorkingSetStart = \" + Str(File"
MessageExpr Line0002 = "Globals.WorkingSetStart) + \"\\n\" +  \n\"    FileGlobals.WorkingSetEnd = \" + Str(FileGlobals.WorkingSetEnd) + \"\\n\\n"
MessageExpr Line0003 = "\" +  \n\"    Delta = \" + Str((FileGlobals.WorkingSetEnd - FileGlobals.WorkingSetStart) / 1024) + \"K\\n\""

[DEF, SF.Seq[0].Main[19]]
%NAME = "Report Memory Loss > 1K"

