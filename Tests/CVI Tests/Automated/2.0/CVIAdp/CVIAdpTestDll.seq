%FLG: SData = 2097152

[SF.Seq[1].Main[12].TS.SData]
ModulePath = "CVIAdpTest.dll"
FuncName = "TestErrorOccurredStructurePackingTrue"
ModuleSrcPath = "CVIAdpTest.c"
ModulePrjPath = "CVIAdpTest.prj"

[SF.Seq[1].Main[12]]
%COMMENT Line0001 = "This step is supposed to fail.  Its failure does NOT cause sequence failure.  You should select run cleanup. There is a "
%COMMENT Line0002 = "step in the cleanup that verifies that the error.occurred in this step is TRUE."

[DEF, SF.Seq[1].Main[12]]
%NAME = "Action - set error occurred true"

[DEF, SF.Seq[1].Cleanup]
%[0] = NoneStep
%TYPE: %[0] = "PassFailTest"

[SF.Seq[1].Cleanup[0].TS]
Adapter = "None Adapter"
PreCond Line0001 = "AllOf(RunState.Sequence.Main[\"Action - set error occurred true\"].Result.Status != \"\", RunState.Sequence.Main[\"Actio"
PreCond Line0002 = "n - set error occurred true\"].Result.Status != \"Skipped\")"
StatusExpr Line0001 = "Step.DataSource != \"Step.Result.PassFail\" ? Step.Result.PassFail = Evaluate(Step.DataSource) : False, Step.Result.Pass"
StatusExpr Line0002 = "Fail ? \"Passed\" : \"Failed\""

[DEF, SF.Seq[1].Cleanup[0].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[SF.Seq[1].Cleanup[0]]
DataSource = "RunState.Sequence.Main[\"Action - set error occurred true\"].Result.Error.Occurred"

[DEF, SF.Seq[1].Cleanup[0]]
%NAME = "Check Error Occurred"

