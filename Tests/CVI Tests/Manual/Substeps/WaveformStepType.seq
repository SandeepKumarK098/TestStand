%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[1]]
%NAME = "Text Report"

[SF.Seq[2].Main[2].TS]
Adapter = "None Adapter"
PostExpr = "Locals.Indentation = Str(\"\", \"%\" + Str(Parameters.Level * 3) + \"s\")"

[DEF, SF.Seq[2].Main[2].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[2]]
%NAME = "Compute Indentation String"

[SF.Seq[2].Main[3].TS]
Adapter = "None Adapter"
PostExpr = "Locals.DetailsIndentation = Locals.Indentation + \"     \""

[DEF, SF.Seq[2].Main[3].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[3]]
%NAME = "Compute Details Indentation"

[SF.Seq[2].Main[4].TS]
Adapter = "None Adapter"
PreCond Line0001 = "Parameters.ReportOptions.IncludeMeasurements && PropertyExists(\"Parameters.Result.RMSvalue\") &&  \nParameters.ReportOp"
PreCond Line0002 = "tions.Format == \"txt\""
PostExpr Line0001 = "Parameters.ReportEntry += Locals.DetailsIndentation + \"RMS Value:                \" + Str(Parameters.Result.RMSvalue) +"
PostExpr Line0002 = " \"\\n\""

[DEF, SF.Seq[2].Main[4].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[4]]
%NAME = "Add RMS Value - Text"

[SF.Seq[2].Main[5].TS]
Adapter = "None Adapter"

[DEF, SF.Seq[2].Main[5].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[5]]
%NAME = "Finish"

[SF.Seq[2].Main[6].TS]
Adapter = "None Adapter"

[DEF, SF.Seq[2].Main[6].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[6]]
%NAME = "HTML Report"

[SF.Seq[2].Main[7].TS]
Adapter = "None Adapter"
PostExpr Line0001 = "Locals.LabelStart = \"<TR><TD BGCOLOR=\" +  Parameters.ReportOptions.Colors.LabelBg + \"><FONT SIZE=-1>\" , Locals.Value"
PostExpr Line0002 = "Start = \"<TD BGCOLOR=\" +  Parameters.ReportOptions.Colors.ValueBg + \"><FONT SIZE=-1>\""

[DEF, SF.Seq[2].Main[7].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[7]]
%NAME = "Compute Label and Value HTML Prefix"

[SF.Seq[2].Main[8].TS]
Adapter = "None Adapter"
PreCond Line0001 = "AllOf(Parameters.ReportOptions.IncludeMeasurements && PropertyExists(\"Parameters.Result.RMSvalue\"), Parameters.ReportO"
PreCond Line0002 = "ptions.Format == \"html\")"
PostExpr Line0001 = "Parameters.ReportEntry += Locals.LabelStart + \"RMS Value\" +  Locals.ValueStart + Str(Parameters.Result.RMSvalue) + \"\"
PostExpr Line0002 = "\n\""

[DEF, SF.Seq[2].Main[8].TS]
SData = "TYPE, NoneStepAdditions"
%FLG: SData = 2097152

[DEF, SF.Seq[2].Main[8]]
%NAME = "Add RMS Value - HTML"

