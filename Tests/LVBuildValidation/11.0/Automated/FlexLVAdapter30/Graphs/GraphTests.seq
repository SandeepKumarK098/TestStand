[DEF, SF.Seq[3].Main[3]]
%NAME = "--- Digital Waveform Graph ---"

[SF.Seq[3].Main[4].TS]
Id = "ID#:2FjwJgSC30KsxjeYQJDObC"

[DEF, SF.Seq[3].Main[4].TS]
SData = "TYPE, FlexGStepAdditions"
%FLG: SData = 2097152

[SF.Seq[3].Main[4].TS.SData.ViCall]
VIPath = "Digital Waveform Graph.vi"
ViDescription Line0001 = "The Digital Waveform Graph visually displays a numeric set of data where each plot represents one bit in the data.  This"
ViDescription Line0002 = " example displays the functionality of the Digital Waveform Graph.  It allows the user to vary the number of points, typ"
ViDescription Line0003 = "e of input, number of ports, and mask type.\n\nThe Points control determines how many data points will be transferred to"
ViDescription Line0004 = " the chart.  The number chosen will be shown on X-axis of the Digital Waveform Graph, which will span from 0.0 to (Point"
ViDescription Line0005 = "s - 1).  \n\nThe Data Type control configures the pattern of data sent to the graph.  The user can select count, step, o"
ViDescription Line0006 = "r random:  \n\nCount - produces a 1D array of data (0,1,2,...,(Points-1)).  The array will repeat after 255 has been rea"
ViDescription Line0007 = "ched.\nStep - produces a repeating 1D array of data (2^0, 2^1, 2^2,...,2^7).\nRandom - produces a 1D array of random dat"
ViDescription Line0008 = "a (0 to 255).\n\nThe Number of Ports control specifies the number of data elements to treat as one digital datum. If you"
ViDescription Line0009 = " have 8-bit data represented as an 8-bit integer, then the number of ports is one.\n\nThe Mask Type control configures t"
ViDescription Line0010 = "he type of mask that will be applied to the digital data.  Masking allows the user to select, reorder, and combine bits "
ViDescription Line0011 = "in the data before displaying it on the graph.  The user can select Custom, One Bus, or All Lines:  \n\nCustom - Uses \""
ViDescription Line0012 = "Mask Bits\" LED array on front panel to produce mask.\nOne Bus - Produces a mask with one row and entries for all bits.\"
ViDescription Line0013 = "nAll Lines - Show each individual line."
TDChecksum = -258106054
%LO: Parms = [0]
%HI: Parms = [0]

