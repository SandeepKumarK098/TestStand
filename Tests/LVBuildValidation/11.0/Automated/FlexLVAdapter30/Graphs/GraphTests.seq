[SF.Seq[2].Main[0].TS.SData.ViCall]
VIPath = "Intensity Chart and Graph.vi"
ViDescription Line0001 = "This VI shows the difference between the intensity chart and the intensity graph. It generates a array or random values "
ViDescription Line0002 = "and then sorts the data and passes it to the Intensity Graph and Intensity Chart.\n\nThe <B>Intensity Graph</B> maps 2 d"
ViDescription Line0003 = "imensional array of numeric values to colors according to its Z scale.  The graph draws its data every time data is sent"
ViDescription Line0004 = " to it and has no memory of previous data.\n\nThe <B>Intensity Chart</B> maps its data in the same way but it keeps a hi"
ViDescription Line0005 = "story of the data it has been sent.  With the scroll bar it is possible to look back through the history.\n\n"
TDChecksum = -866137618
%LO: Parms = [0]
%HI: Parms = [1]

