ExpressVIName = "Collector"
VIType = 1
VIDescription Line0001 = "Collects input signals and returns the most recent data, up to the specified maximum number of samples per channel. When"
VIDescription Line0002 = " you call this Express VI repeatedly and the Express VI reaches the maximum number of samples per channel, the Express V"
VIDescription Line0003 = "I discards the oldest data and adds the newest data to the collected samples.\n--------------------\n\nThis Express VI i"
VIDescription Line0004 = "s configured as follows:\n\nNumber of Points to Collect:  1000\n"
