VIDescription Line0003 = "a predefined number of samples.\n--------------------\n\nThis Express VI is configured as follows:\n\nStart Trigger Conf"
VIDescription Line0004 = "iguration:\nType: Threshold\r\nSense: Rising\r\nThreshold: 0\r\nHysterisis: 0\r\n\r\nStop Trigger Configuration:\nType: "
