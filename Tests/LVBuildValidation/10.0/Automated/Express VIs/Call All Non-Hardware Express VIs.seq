VIType = 1
VIDescription Line0001 = "Appends signals to each other. You can use this Express VI to append a signal to the end of another signal, append signa"
VIDescription Line0002 = "ls in a combined signal to each other, append the same signal to the end of each signal in a combined signal, or append "
VIDescription Line0003 = "a combined signal to another combined signal.\n--------------------\n\nThis Express VI is configured as follows:\n\nAppe"
VIDescription Line0004 = "nd even if t0 does not align and dt does not match.\n"
