PostExpr Line0001 = "Locals.ExpectedVIVersion == Locals.VIVersion ? Step.Result.ReportText = \"\" : (Step.Result.ReportText = \"Error: Expect"
PostExpr Line0002 = "ed VI Version '\" + Locals.ExpectedVIVersion + \"', found '\" + Locals.VIVersion + \"'\", Locals.noError = False), \rLoc"
PostExpr Line0003 = "als.ExpectedUserName == Locals.UserName ? Step.Result.ReportText += \"\" : (Step.Result.ReportText += \"Error: Expected "
PostExpr Line0004 = "User Name '\" + Locals.ExpectedUserName + \"', found '\" + Locals.UserName + \"'\", Locals.noError = False),\rLocals.Exp"
PostExpr Line0005 = "ectedOSName == Locals.OSName ? Step.Result.ReportText += \"\" : (Step.Result.ReportText = \"Error: Expected OS Name '\" "
PostExpr Line0006 = "+ Locals.ExpectedOSName + \"', found '\" + Locals.OSName + \"'\", Locals.noError = False)"
StatusExpr = "Locals.noError ? \"Passed\" : \"Failed\""

