%NAME = "Wait for Data Socket to Open"

[SF.Seq[0].Main[8].TS]
Id = "ID#:YLL7QAlg10KB72lf9dpywC"
PostExpr Line0001 = "Find(Locals.DataRead, Locals.StringToPass) != -1 ?\nStep.Result.ReportText = \"\" :\n(Step.Result.ReportText = \"Expecte"
PostExpr Line0002 = "d data received to have the string '\" + Locals.StringToPass + \"', found '\" + Locals.DataRead + \"'\")"
StatusExpr = "Find(Locals.DataRead, Locals.StringToPass) != -1 ? \"Passed\" : \"Failed\""

[DEF, SF.Seq[0].Main[8].TS]
SData = "TYPE, FlexGStepAdditions"

[SF.Seq[0].Main[8].TS.SData.ViCall]
VIPath = "ReadFromDS.vi"
ShowFrnPnl = True
VIDescription Line0001 = "This example illustrates using datasocket for reading in a waveform.    \n                                              "
VIDescription Line0002 = "                          \nIt works with http, ftp,and local files, as well as with live data. \n\nTo use with static f"
VIDescription Line0003 = "iles, select one of the URLs beginning with file, ftp, or http listed at the bottom of the front panel, and enter it int"
VIDescription Line0004 = "o the text box.  Then start the VI.   \n                                                                         \nTo us"
VIDescription Line0005 = "e it with live data, start the DataSocket Server from the Start menu and run the LVDSWriter example.  Then select the sa"
VIDescription Line0006 = "me URL (dstp://localhost/wave) for this example and press the connect button.                                   \n      "
VIDescription Line0007 = "                                                                   \nThe Writer, Server, and Reader can all be on the sa"
VIDescription Line0008 = "me machine or different machines.  The Writer's and Reader's URL should point to the machine that the DataSocket Server "
VIDescription Line0009 = "is on.                           \n                                                                         \n"
TDChecksum = -1279222798
