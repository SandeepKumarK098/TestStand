VIPath = "WriteToDS.vi"
ShowFrnPnl = True
VIDescription Line0001 = "This example illustrates using datasocket for writing out a waveform       \n                                           "
VIDescription Line0002 = "                                 \nIt works for writing the data to local files, or to the DataSocket Server  (for live "
VIDescription Line0003 = "data).                                                           \n                                                     "
VIDescription Line0004 = "                      \nTo use it with live data, start the DataSocket Server from the Start menu and run the DS Reader "
VIDescription Line0005 = "example with the dstp URL (dstp://localhost/wave, for example).  Then select the same URL in this example and start this"
VIDescription Line0006 = " VI.\n                                                                            \nThe Writer, Server, and Reader can a"
VIDescription Line0007 = "ll be on the same machine or different machines.  The Writer's and Reader's URL should point to the machine that the Dat"
VIDescription Line0008 = "aSocket Server is on.                              "
TDChecksum = -36072033
