[SF.Seq[1].Main[1].TS]
Id = "ID#:R33uOMXIb0eoBPCnyN4GdD"
LoopType = "Custom"
LoopWhile = "RunState.LoopIndex < Locals.NumberOfMenuItems && Locals.noError"
LoopStatus = "RunState.LoopNumPassed / RunState.LoopIndex < 1 ? \"Failed\" : \"Passed\""
PreExpr = "Locals.noError = True"
PostExpr Line0001 = "Locals.MenuItemNames[Runstate.LoopIndex] == Parameters.MenuItemsInserted[RunState.LoopIndex].ItemName ? Step.Result.Repo"
PostExpr Line0002 = "rtText = \"\" : ( Step.Result.ReportText = \"Expected menu item name '\" + Parameters.MenuItemsInserted[RunStateLoopInde"
PostExpr Line0003 = "x].ItemName  + \"', found menu item name '\" + Locals.MenuItemNames[Runstate.LoopIndex] +\"'\", Locals.noError = False)"
StatusExpr = "Locals.noError ? \"Passed\" : \"Failed\""

