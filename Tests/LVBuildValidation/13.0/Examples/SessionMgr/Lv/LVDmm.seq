[DEF, SF.Seq[1].Main]
%[0] = Step
%TYPE: %[0] = "MessagePopup"

[SF.Seq[1].Main[0].TS]
Id = "ID#:scp7IMh0NkKmXU0ope1jGC"
Mode = "Skip"

[SF.Seq[1].Main[0]]
TitleExpr = "\"Session Manager Demo Using LabVIEW\""
MessageExpr Line0001 = "\"This sequence demonstrates how to use the Session Manager to share named instrument handles between test modules. The "
MessageExpr Line0002 = "Get DMM Session step obtains a reference to the session that Locals.logicalName specifies. The step stores the reference"
MessageExpr Line0003 = " in a local variable so that the session will exist until the execution completes.\n\nThe remaining steps in the sequenc"
MessageExpr Line0004 = "e call test modules. Each test module calls the Session Manager to obtain the instrument handle for the session that Loc"
MessageExpr Line0005 = "als.logicalName specifies. Because the Get DMM Session step stores a reference to the session in a local variable, ensur"
MessageExpr Line0006 = "ing that the session exists for the life of the execution, each module uses the same session, and the instrument initial"
MessageExpr Line0007 = "izes and closes only once.\n\nRefer to Start>>Programs>>National Instruments>>Session Manager>>NI Session Manager Help f"
MessageExpr Line0008 = "or a description of the Session Manager.\n\nNOTE: This sequence requires the LabVIEW development system and the IVI LabV"
MessageExpr Line0009 = "IEW components. You can install the IVI components from the National Instruments Driver CD included in your TestStand pa"
MessageExpr Line0010 = "ckage.\""
DefaultResponse = "<Obsolete, Use DefaultResponseExpr>"
DefaultResponseExpr = "\"\""

[DEF, SF.Seq[1].Main[0]]
%NAME = "Explain Demo"

