Id = "ID#:K5y33Br92Eql/TzwdwsRRA"
Mode = "Skip"

[SF.Seq[1].Main[0]]
TitleExpr = "\"Calling Express VIs (Within Range)\""
MessageExpr Line0001 = "\"This example shows how you can call LabVIEW Express VIs from TestStand.\n\nYou can call any of the built in Express VI"
MessageExpr Line0002 = "s Shipped with LabVIEW using the National\nInstruments step types such as numeric limit Test or Pass/Fail Test.  You can"
MessageExpr Line0003 = " then select\nthe parameters to pass into the Express VI using the Specify Module Dialog.    \n\nThis sequence creates t"
MessageExpr Line0004 = "wo simulated signals. One is used as the expected signal and the\nother one is the signal read, i.e. from an instrument "
MessageExpr Line0005 = "like a scope. The read signal is compare\nagainst the expected signal to see if the read signal is within the expected r"
MessageExpr Line0006 = "ange.\""

[DEF, SF.Seq[1].Main[0]]
%NAME = "Explain Example"

