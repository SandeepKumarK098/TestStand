[DEF, SF.Seq[6].Main[2]]
%NAME = "Read Text From File"

[SF.Seq[6].Main[3].TS]
Id = "ID#:Mi+FNxtsCEO2Q0yI2zk0hB"
PreCond = "Find( Locals.TextString, \"\\\"\" ) != 0"
PassAct = "Goto"
PassActTarget = "\"<Cleanup>\""
CustExpr = "True"
CustTrueAct = "Goto"
CustTrueActTarget = "\"<Cleanup>\""

[SF.Seq[6].Main[3]]
TitleExpr = "\"No Steps Found\""
MessageExpr Line0001 = "\"No steps were found in the *.ini file or the file did not have the proper formatting.\nFormatting should appear as\n\n"
MessageExpr Line0002 = "\\\"Step One\\\"\n\\\"Step Two\\\"\n\\\"Step Three\\\"\""

[DEF, SF.Seq[6].Main[3]]
%NAME = "No Steps Found"

[SF.Seq[6].Main[4].TS]
Id = "ID#:HwXi1YxEB0qOEUGt0L1rQC"

[DEF, SF.Seq[6].Main[4]]
%NAME = "Begin Loop"

[SF.Seq[6].Main[5].TS]
Id = "ID#:0EqvxyBD5EivSBUc6/jHUA"
PostExpr = "Locals.StringLength = Len( Locals.TextString )"

[DEF, SF.Seq[6].Main[5]]
%NAME = "Get Length of Text String"

[SF.Seq[6].Main[6].TS]
Id = "ID#:0W3cItmMu0+YO3O0dJVdBC"
PostExpr = "Locals.IndexA = Find( Locals.TextString, \"\\\"\")"

[DEF, SF.Seq[6].Main[6]]
%NAME = "Get IndexA"

[SF.Seq[6].Main[7].TS]
Id = "ID#:uYwmr0TPjU+2lA6nu1NqGC"
PostExpr = "Locals.IndexB = Find( Locals.TextString, \"\\\"\", Locals.IndexA + 1)"

[DEF, SF.Seq[6].Main[7]]
%NAME = "Get Index B"

[SF.Seq[6].Main[8].TS]
Id = "ID#:jZhG+zdngUegBDMKdCpezB"
PostExpr Line0001 = "SetNumElements(Parameters.ListOfSteps, Locals.Element + 1), Parameters.ListOfSteps[Locals.Element] = Left(Locals.TextStr"
PostExpr Line0002 = "ing, (Locals.IndexB - Locals.IndexA + 1))"

[DEF, SF.Seq[6].Main[8]]
%NAME = "Add Step Name to ListOfSteps"

[SF.Seq[6].Main[9].TS]
Id = "ID#:fZBe6i6QCUCnvjpmjpSKaC"
PostExpr Line0001 = "Len(Locals.TextString) != (Locals.IndexB - Locals.IndexA +1) ? (Locals.TextString = Right(Locals.TextString, (Locals.Str"
PostExpr Line0002 = "ingLength - (Locals.IndexB - Locals.IndexA +2)))) : (Locals.TextString = \"\")"

[DEF, SF.Seq[6].Main[9]]
%NAME = "Remove Step Name From Text String"

[SF.Seq[6].Main[10].TS]
Id = "ID#:601SnNDtl0WyOfkUR+yNpD"
PostExpr = "Parameters.ListOfSteps[Locals.Element] = SearchAndReplace(Parameters.ListOfSteps[Locals.Element], \"\\\"\", \"\")"

[DEF, SF.Seq[6].Main[10]]
%NAME = "Remove Quotes Around Step Name"

[SF.Seq[6].Main[11].TS]
Id = "ID#:b7NayncIdUqMHjP5xQA2BC"
PostExpr = "Locals.Element++"

[DEF, SF.Seq[6].Main[11]]
%NAME = "Increment Element Number"

[SF.Seq[6].Main[12].TS]
Id = "ID#:Xvw3k1BEQU2XzLg7C2oGOC"
PreCond = "Find(Locals.TextString, \"\\\"\") != -1"
CustTrueActTarget = "\"Begin Loop\""

[DEF, SF.Seq[6].Main[12]]
%NAME = "Goto Begin Loop"

