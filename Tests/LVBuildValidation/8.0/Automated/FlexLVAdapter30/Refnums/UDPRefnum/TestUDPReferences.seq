[SF.Seq[0].Main[2].TS.SData.ViCall]
VIPath = "UDP Multicast Sender.vi"
VIDescription Line0001 = "UDP multicast will allow LabVIEW to send data to a multicast group or to receive data sent to a multicast group. In LabV"
VIDescription Line0002 = "IEW, UDP multicast is used in very much the same way as UDP.  The main difference is there are two new parameters, TTL a"
VIDescription Line0003 = "nd Multicast Address, on the UDP Multicast Open.  \n\nWhen sending to a multicast group the default time-to-live (TTL) i"
VIDescription Line0004 = "s 1, which only allows the packet to go to the local subnet. When a router receives a multicast packet, it decrements th"
VIDescription Line0005 = "e packets TTL, and if the TTL is greater than 0, forwards the packet to other routers.\nA multicast group is defined by "
VIDescription Line0006 = "having a multicast IP address in the range 224.0.0.0-239.255.255.255.\n"
TDChecksum = -24927235
